<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bookstore.Data</RootNamespace>
    <AssemblyName>Bookstore.Data</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF6 -> EF Core: Breaking migration, not drop-in. See data-access-migration phase. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- Configuration: System.Configuration.ConfigurationManager for legacy ConfigurationManager -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <!-- AWS SDK packages: modern versions compatible with net8.0 -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.7" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="AWSSDK.Rekognition" Version="4.0.101" />
    <!-- ImageMagick: modern version compatible with net8.0 -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
  </ItemGroup>
</Project>
