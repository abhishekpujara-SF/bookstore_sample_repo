<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bookstore.Web</RootNamespace>
    <AssemblyName>Bookstore.Web</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Common\Bookstore.Common.csproj" />
    <ProjectReference Include="..\Bookstore.Data\Bookstore.Data.csproj" />
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF6 -> EF Core: Breaking migration. See data-access-migration phase. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    
    <!-- DI: Autofac.Mvc5 -> built-in DI or Autofac.Extensions.DependencyInjection -->
    <PackageReference Include="Autofac" Version="9.3.4" />
    <!-- TODO configuration-migration: Replace with Autofac.Extensions.DependencyInjection for ASP.NET Core -->
    
    <!-- AWS SDK packages -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.7" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="AWSSDK.Rekognition" Version="4.0.101" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.104.3" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.103.9" />
    
    <!-- Logging -->
    <PackageReference Include="NLog" Version="6.2.1" />
    <PackageReference Include="AWS.Logger.NLog" Version="5.0.1" />
    
    <!-- JSON serialization: keeping Newtonsoft.Json (still fully supported) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    
    <!-- Authentication: OWIN -> ASP.NET Core auth. See auth-security-migration phase. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    
    <!-- REMOVED (built into ASP.NET Core / SDK):
         - Microsoft.AspNet.Mvc (5.3.0)
         - Microsoft.AspNet.Razor (3.3.0)
         - Microsoft.AspNet.Web.Optimization (1.1.3) - see mvc-webapi-migration for bundling
         - Microsoft.AspNet.WebPages (3.3.0)
         - Microsoft.CodeDom.Providers.DotNetCompilerPlatform (4.1.0)
         - Microsoft.Web.Infrastructure (2.0.1)
         - WebGrease (1.6.0)
         - Antlr (3.5.0.2)
    -->
    
    <!-- MOVED to wwwroot (client-side libraries):
         - jQuery (3.7.1)
         - jQuery.Validation (1.21.0)
         - Microsoft.jQuery.Unobtrusive.Validation (4.0.0)
         - Modernizr (2.8.3)
         See mvc-webapi-migration phase.
    -->
    
    <!-- REPLACED by ASP.NET Core middleware (see auth-security-migration):
         - Microsoft.Owin (4.2.2)
         - Microsoft.Owin.Host.SystemWeb (4.2.2)
         - Microsoft.Owin.Security (4.2.2)
         - Microsoft.Owin.Security.Cookies (4.2.2)
         - Microsoft.Owin.Security.OpenIdConnect (4.2.2)
         - Owin (1.0)
         - Autofac.Owin (7.1.0)
         - Autofac.Mvc5 (6.1.0)
    -->
  </ItemGroup>
</Project>
